# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA...
# Канал, на который надо подписаться (бот должен быть в нём АДМИНОМ)
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel
# Закрытый канал-хранилище с видео-уроками (бот тоже админ). Узнать ID: перешли боту пост оттуда
STORAGE_CHAT_ID=-1004361759890
# Твой Telegram user_id (узнать: напиши боту /id). Несколько — через запятую
ADMIN_IDS=123456789
# Адрес веб-приложения Apps Script из Google Таблицы (Deploy -> Web app -> URL)
SHEET_URL=https://script.google.com/macros/s/XXXX/exec
# Пароль: тот же, что в скрипте таблицы. Только латиница, цифры, _ и -
SECRET=moi_parol_123
# Только для запуска на своём компе через туннель; на Render не нужен
# PUBLIC_URL=https://xxxx.ngrok.app

# ---------- Оплата сообщества через Stripe (необязательно) ----------
# Пока STRIPE_SECRET_KEY пустой, кнопка оффера ведёт на button_url из lessons.json, как раньше.
# Restricted key (rk_test_... / rk_live_...) с правами из README. Ключи НИКОГДА не коммить в GitHub.
STRIPE_SECRET_KEY=
# Секрет вебхука (whsec_...) из Stripe Dashboard → Developers → Webhooks → твой endpoint
STRIPE_WEBHOOK_SECRET=
# ID цены подписки $50/мес (price_...). Уже вписан в bot.py, задавать только если цена поменяется
STRIPE_PRICE_ID=
# Закрытый чат или канал сообщества (-100...). Бот — админ с правами приглашать и банить
COMMUNITY_CHAT_ID=
# Текст на кнопке оплаты
PRICE_LABEL=$50 в месяц
# 1 — считать налог через Stripe Tax. Включать ТОЛЬКО после настройки Tax (см. README)
STRIPE_AUTOMATIC_TAX=0
